  "common_krait": {
    "common_name": "Common Krait",
    "scientific_name": "Bungarus caeruleus",
    "family": "Elapidae",
    "venom_syndrome": "neurotoxic",
    "venom_subtype": "pre_synaptic_neurotoxic",
    "confirmed_telangana": true,
    "ap_telangana_rank": 1,
    "clinical_notes": "Most frequent cause in Khammam study (10/30 cases). Pre-synaptic neurotoxin - antivenom less effective. Night biting. Bite often painless.",
    "danger_level": "very_high",
    "habitat": ["agricultural_fields", "human_dwellings", "paddy_fields", "scrubland"],
    "districts_high_prevalence": ["Khammam", "Nalgonda", "Warangal", "Mahabubabad", "Bhadradri_Kothagudem", "Krishna", "Guntur", "West_Godavari", "East_Godavari"],
    "districts_moderate_prevalence": ["Adilabad", "Nizamabad", "Karimnagar", "Medak", "Kurnool", "Prakasam", "Nellore"],
    "districts_low_prevalence": ["Hyderabad", "Visakhapatnam_hills", "Srikakulam_coast"],
    "time_of_day": {
      "night": 0.85,
      "evening": 0.10,
      "morning": 0.04,
      "afternoon": 0.01
    },
    "season": {
      "monsoon": 0.65,
      "post_monsoon": 0.20,
      "summer": 0.10,
      "winter": 0.05
    },
    "key_symptoms": {
      "high_weight": ["ptosis", "dysphagia", "respiratory_distress", "paralysis", "muscle_weakness", "dysarthria"],
      "moderate_weight": ["diplopia", "nausea", "minimal_local_swelling", "abdominal_cramp"],
      "distinguishing": ["painless_or_minimal_pain", "no_local_swelling", "delayed_onset", "night_bite"]
    },
    "antivenom": {
      "type": "polyvalent_asv",
      "effectiveness": "moderate",
      "note": "Pre-synaptic toxin causes nerve terminal damage before antivenom can act. Ventilator support critical.",
      "vials_range": [15, 50]
    },
    "typical_onset_hours": [1, 6],
    "mortality_risk_untreated": "very_high"
  },

